# ==========================================
# MULTI-VISION Project Root .gitignore
# ==========================================

# Python Virtual Environments
venv/
.venv/
.vny/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & Local Data Fills
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/system.db

# Large Model Files & Runs (if dynamically downloaded)
*.pt
*.onnx
runs/
backend/runs/

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS System Files
.DS_Store
Thumbs.db
